# Copy to .env and fill in the first section. Everything that changes how the
# app behaves is set here; nothing is fixed in the code. A line you leave out
# falls back to the value shown in this file.

# ---- Required ---------------------------------------------------------------

# Your name as colleagues say it. The assistant joins as "<OWNER_NAME>'s AI Assistant".
OWNER_NAME=

# ElevenLabs: the voice clone and text-to-speech (and paid transcription, if turned on).
ELEVENLABS_API_KEY=
# Your cloned voice. Paste the Voice ID from ElevenLabs, or let the Voice page fill it in.
ELEVENLABS_VOICE_ID=

# ---- Telegram (optional but recommended) --------------------------------------

# Create a bot with @BotFather, paste its token here, then send /start to the bot.
TELEGRAM_BOT_TOKEN=
# Filled in automatically the first time you send /start.
TELEGRAM_CHAT_ID=

# ---- Server -------------------------------------------------------------------

# Port of the API server (the web app talks to it).
PORT=8787
# Port of the web app you open in the browser.
WEB_PORT=5173
# 1 hides the browser windows the assistant uses to join meetings.
HEADLESS=0
# Where the database is kept. Empty means data/agentic-brother.db in this folder.
AB_DB_PATH=
# Largest file accepted by "Add from file", in megabytes.
UPLOAD_MAX_MB=25
# Hosts a meeting link may point to, comma separated.
TEAMS_HOSTS=teams.microsoft.com,teams.live.com,teams.microsoft.us

# ---- Models -------------------------------------------------------------------

# Claude, through your Claude Code subscription (no API key).
# Decides what to do and writes what is said, live in the meeting. Speed matters most.
BRAIN_MODEL=haiku
# Writes the notes after the meeting.
SUMMARY_MODEL=sonnet
# Writes the mid-meeting catch-up. Empty means the same as BRAIN_MODEL.
CATCHUP_MODEL=
# How far back a catch-up looks, in minutes.
CATCHUP_MINUTES=10

# ElevenLabs.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime

# ---- ElevenLabs credit limits ---------------------------------------------------

# captions   = read Teams' own live captions. Free. Only the voice uses credits.
# elevenlabs = paid realtime transcription. More accurate and a little faster.
STT_MODE=captions
# With STT_MODE=elevenlabs: stop paying after this many minutes of speech per
# meeting and carry on with Teams captions. Silence is never uploaded.
STT_MAX_MINUTES=15
# Characters the voice may speak per meeting (about 2.5 minutes of speech).
# After that, replies are posted in the meeting chat instead.
TTS_MAX_CHARS=2500
# Characters the voice may speak per day across ALL meetings. Several meetings
# at once spend in parallel, so this is the overall ceiling.
TTS_DAILY_MAX_CHARS=6000
# ElevenLabs requests allowed at the same time (their plans limit this).
TTS_CONCURRENCY=2
# Longest sentence the Voice page will speak as a test.
VOICE_TEST_MAX_CHARS=120

# ---- Several meetings -----------------------------------------------------------

# How many real meetings the assistant may attend at the same time. Each one is
# its own browser window, so keep this to what your computer handles comfortably.
MAX_MEETINGS=3

# ---- Thinking out loud ----------------------------------------------------------

# While it works out the answer to a direct question, the assistant says a short
# filler. Each line is paid for once, saved in data/voice-cache and replayed for
# free afterwards. 0 turns fillers off.
FILLERS=1
# The filler lines, separated by |
FILLER_LINES=Hmm, let me check.|Um, one second.|Okay, let me see.|Hmm, okay.|Right, so.
# Say a filler if the answer has not started after this many milliseconds.
FILLER_AFTER_MS=900

# ---- Turn-taking in the meeting ---------------------------------------------------

# Quiet needed before the assistant starts talking, in milliseconds.
FLOOR_SILENCE_MS=600
# Raise a hand after waiting this long for a gap.
RAISE_HAND_AFTER_SECONDS=6
# Give up waiting for a gap and post in the meeting chat instead.
CHAT_FALLBACK_AFTER_SECONDS=25
# Room quiet this long and the update not yet given: offer it unasked.
LULL_SECONDS=20
# Wait this long before offering it again.
LULL_RETRY_SECONDS=90
# Ordinary chatter is judged in batches this long, which keeps Claude usage down.
BATCH_SECONDS=6
# If Claude stops answering, try again after this long.
BRAIN_RETRY_SECONDS=120
# Speech that has not started playing after this long is not reaching the
# meeting. The assistant tells you and switches to the meeting chat.
AUDIO_STALL_SECONDS=3

# ---- Leaving ----------------------------------------------------------------------

# Leave this many seconds after everyone else has left the meeting.
ALONE_EXIT_SECONDS=10
# Leave when nobody has spoken for this many minutes.
IDLE_EXIT_MINUTES=10
# Give up if nobody admits the assistant from the lobby within this many minutes.
LOBBY_TIMEOUT_MINUTES=10

# ---- Scheduling -------------------------------------------------------------------

# Telegram heads-up this many minutes before a scheduled join.
SCHEDULE_REMIND_MINUTES=5
# Still join if the start time passed no more than this many minutes ago.
SCHEDULE_LATE_MINUTES=10

# ---- Machine resources ---------------------------------------------------------

# Measure each meeting's browser memory and CPU this often (seconds), print it
# in the server console and keep the peak and average with the meeting. 0 = off.
RESOURCE_SAMPLE_SECONDS=30

# ---- Hearing ----------------------------------------------------------------------

# Loudness (0 to 1) above which sound counts as someone talking.
VAD_THRESHOLD=0.02
# Continuous sound needed before it counts as speech, in milliseconds.
VAD_MIN_SPEECH_MS=400
# A caption counts as finished once it has not changed for this long (milliseconds).
CAPTION_STABLE_MS=1500
# The same, when the caption already ends a sentence.
CAPTION_SENTENCE_STABLE_MS=700
